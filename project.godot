[application]
config/name="Island Awakening"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
SaveManager="*res://scripts/core/save_manager.gd"
MissionManager="*res://scripts/core/mission_manager.gd"
NetworkManager="*res://scripts/network/network_manager.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.055, 0.09, 1)

[physics]
3d/default_gravity=18.0

[input]
move_forward={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":68)]}
jump={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":32)]}
sprint={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
crouch={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":67),Object(InputEventKey,"physical_keycode":4194327)]}
attack={"deadzone":0.1,"events":[Object(InputEventMouseButton,"button_index":1)]}
interact={"deadzone":0.1,"events":[Object(InputEventMouseButton,"button_index":2),Object(InputEventKey,"physical_keycode":69)]}
reload={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":82)]}
inventory={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":4194308)]}
map={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":77)]}
slot_1={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":49)]}
slot_2={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":50)]}
slot_3={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":51)]}

[audio]
default_bus_layout="res://assets/audio/default_bus_layout.tres"
